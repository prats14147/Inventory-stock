# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---
# Local Postgres (matches docker-compose.yml service "postgres")
DATABASE_URL=postgresql+psycopg2://inventory_user:inventory_pass@localhost:5432/inventory_db
# To use Supabase instead, replace this with the Session pooler URL from the
# project's Connect panel, using the postgresql+psycopg2:// scheme. Keep the
# password private in your local .env; see docs/supabase_database_setup.md.

# --- LLM provider ---
# auto selects Gemini when GEMINI_API_KEY is set; otherwise Groq.
# Explicit choices: gemini, groq, auto.
LLM_PROVIDER=auto

# Gemini (Google AI Studio)
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Groq (optional alternative)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- Forecasting defaults ---
DEFAULT_FORECAST_HORIZON=14

# --- Reorder / stockout-risk assumptions ---
# No supplier lead-time column exists in the dataset, so this is a
# configurable, documented assumption (see docs/limitations.md).
DEFAULT_LEAD_TIME_DAYS=7
SAFETY_STOCK_SERVICE_FACTOR=1.65

# --- Inventory thresholds ---
LOW_STOCK_THRESHOLD=50

# --- Real-time layer (Tier 1 demo) ---
# The data simulator is a DEMO device, not a data source: it writes synthetic
# sales events to its own table (live_sales_events) and never touches
# daily_sales/daily_inventory, so analytics and forecasts stay reproducible.
# Leave it off and start it from the dashboard (POST /api/simulator/start),
# or enable the auto-start below.
SIMULATOR_ENABLED=false
SIMULATOR_TICK_SECONDS=3.0
SIMULATOR_EVENTS_PER_TICK=3
# An alert for a product is not repeated at the same severity inside this window.
SIMULATOR_ALERT_COOLDOWN_SECONDS=120

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Access control ---
# Required to sign in. Use a unique username and strong password per deployment.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin@123
# Use a random secret of at least 32 characters; never reuse the example value.
AUTH_TOKEN_SECRET=MDDFCU_1uPD_PuzdwPUzDDTdsyuK5SdRCigMqUu7kupMs1wsr_M68mS00VJS3JsE
AUTH_TOKEN_TTL_MINUTES=60
# Comma-separated browser origins allowed to call this API. Never use '*'.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
